# =============================================================
# Login Assistant - Configuration (Zero Google Cloud Required!)
# =============================================================

# Server Port
PORT=3001

# Google Spreadsheets (Supports up to 2 sheets with custom display names)
# Share each spreadsheet as "Anyone with the link can view", then paste URL or ID:
GOOGLE_SHEET_ID_1=YOUR_FIRST_GOOGLE_SHEET_URL_OR_ID
GOOGLE_SHEET_NAME_1=Sheet 1

GOOGLE_SHEET_ID_2=
GOOGLE_SHEET_NAME_2=Sheet 2

# Legacy single-sheet fallback
# GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_OR_URL_HERE

# Playwright Browser Automation Settings
PLAYWRIGHT_HEADLESS=false
KEEP_BROWSER_OPEN=true
PLAYWRIGHT_SLOW_MO=50
LOGIN_TIMEOUT_MS=30000
